{
  "_lisezmoi": "LE fichier du modèle. Chaque module déclare ses collections Firestore (sous clubs/{clubId}/), qui peut lire, quel droit faut-il pour écrire, et les champs. Après une modification : npm run regles (réécrit la politique dans firestore.rules). L'appli construit ses écrans (listes + fiches) à partir de ce même fichier.",
  "_aide": {
    "lire": "public = tout le monde (vitrine) ; public? = public si le document a public=true, sinon membres ; membre = membres actifs du club ; sinon le nom d'un droit (limité au périmètre du membre)",
    "ecrire": "le droit nécessaire pour créer, modifier, supprimer (toujours limité au périmètre : sections et catégories du membre)",
    "soi": "true = l'id du document EST la fiche de la personne (collection personnes)",
    "perso": "true = le joueur concerné (personneId = sa fiche) et ses parents (enfants) lisent aussi le document",
    "reponse": "champs que le joueur concerné (ou son parent) peut modifier lui-même, ex. sa réponse à une convocation",
    "garder": "true = jamais supprimé (pièces comptables)",
    "categorie": "true = le document porte sectionId et categorieId (le périmètre s'applique)",
    "types": "texte, texteLong, nombre, montant, date, dateheure, heure, booleen, choix (options), ref (vers une collection), refs (plusieurs), tel, email, image, lien, liste, map"
  },

  "droits": {
    "structure": "Sections, catégories, saisons",
    "membres": "Comptes du club : accepter, donner un rôle et un périmètre",
    "effectif": "Fiches joueurs et staff, licences, équipes, dossiers",
    "sportif": "Planning, convocations, présences, pointage, stats",
    "medical": "Blessures, aptitude, suivi médical (confidentiel)",
    "finances": "Cotisations, échéances, encaissements, dépenses, sponsors",
    "communication": "Actualités, galerie, annonces",
    "installations": "Terrains et réservations",
    "reglages": "Réglages et apparence du club"
  },

  "modules": [
    {
      "id": "base", "nom": "Club", "icone": "🏟️", "obligatoire": true,
      "collections": [
        { "id": "sections", "nom": "Sections (sports)", "lire": "public", "ecrire": "structure",
          "colonnes": ["nom", "sportId"],
          "champs": [
            { "id": "nom", "type": "texte", "label": "Nom", "requis": true },
            { "id": "sportId", "type": "ref", "ref": "/sports", "label": "Sport", "requis": true },
            { "id": "responsable", "type": "texte", "label": "Responsable" },
            { "id": "couleur", "type": "texte", "label": "Couleur" },
            { "id": "ordre", "type": "nombre", "label": "Ordre" },
            { "id": "actif", "type": "booleen", "label": "Active" }
          ] },
        { "id": "categories", "nom": "Catégories", "lire": "public", "ecrire": "structure", "categorie": true,
          "colonnes": ["nom", "sectionId", "sexe"],
          "champs": [
            { "id": "nom", "type": "texte", "label": "Nom (ex. U13 garçons)", "requis": true },
            { "id": "code", "type": "texte", "label": "Code (ex. U13)" },
            { "id": "sexe", "type": "choix", "options": ["M", "F", "Mixte"], "label": "Sexe" },
            { "id": "anneeMin", "type": "nombre", "label": "Né(e) à partir de" },
            { "id": "anneeMax", "type": "nombre", "label": "Né(e) jusqu'à" },
            { "id": "ordre", "type": "nombre", "label": "Ordre" },
            { "id": "actif", "type": "booleen", "label": "Active" }
          ] },
        { "id": "saisons", "nom": "Saisons", "lire": "public", "ecrire": "structure",
          "colonnes": ["nom", "courante"],
          "champs": [
            { "id": "nom", "type": "texte", "label": "Nom (ex. 2026-2027)", "requis": true },
            { "id": "debut", "type": "date", "label": "Début" },
            { "id": "fin", "type": "date", "label": "Fin" },
            { "id": "courante", "type": "booleen", "label": "Saison en cours" }
          ] }
      ]
    },

    {
      "id": "effectif", "nom": "Effectif", "icone": "👥",
      "collections": [
        { "id": "personnes", "nom": "Joueurs et staff", "lire": "effectif", "ecrire": "effectif", "perso": true, "soi": true, "categorie": true,
          "reponse": ["tel", "photo", "contactUrgence"],
          "colonnes": ["nom", "prenom", "type", "poste", "numero"],
