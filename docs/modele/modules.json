            { "id": "naissance", "type": "date", "label": "Date de naissance" },
            { "id": "sexe", "type": "choix", "options": ["M", "F"], "label": "Sexe" },
            { "id": "tel", "type": "tel", "label": "Téléphone" },
            { "id": "email", "type": "email", "label": "E-mail" },
            { "id": "quartier", "type": "texte", "label": "Quartier" },
            { "id": "photo", "type": "image", "label": "Photo" },
            { "id": "poste", "type": "texte", "label": "Poste ou fonction", "selonSport": "postes" },
            { "id": "numero", "type": "nombre", "label": "Numéro de maillot" },
            { "id": "lateralite", "type": "choix", "options": ["droitier", "gaucher", "les deux"], "label": "Pied/main fort(e)" },
            { "id": "taille", "type": "nombre", "label": "Taille (cm)" },
            { "id": "poids", "type": "nombre", "label": "Poids (kg)" },
            { "id": "parents", "type": "liste", "label": "Parents ou tuteurs (nom, téléphone)" },
            { "id": "contactUrgence", "type": "tel", "label": "Contact d'urgence" },
            { "id": "ecole", "type": "texte", "label": "École / profession" },
            { "id": "statut", "type": "choix", "options": ["actif", "essai", "blessé", "prêté", "parti"], "label": "Statut" },
            { "id": "uid", "type": "texte", "label": "Compte lié (identifiant)", "cache": true },
            { "id": "notes", "type": "texteLong", "label": "Notes du staff" }
          ] },
        { "id": "licences", "nom": "Licences", "lire": "effectif", "ecrire": "effectif", "perso": true, "categorie": true,
          "colonnes": ["personneId", "saison", "statut"],
          "champs": [
            { "id": "personneId", "type": "ref", "ref": "personnes", "label": "Personne", "requis": true },
            { "id": "saison", "type": "ref", "ref": "saisons", "label": "Saison", "requis": true },
            { "id": "numero", "type": "texte", "label": "N° de licence" },
            { "id": "federation", "type": "texte", "label": "Fédération / ligue" },
            { "id": "statut", "type": "choix", "options": ["à faire", "dossier incomplet", "envoyée", "validée"], "label": "Statut" },
            { "id": "certificatMedical", "type": "date", "label": "Certificat médical du" },
