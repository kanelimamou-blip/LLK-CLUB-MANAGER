        { "id": "equipes", "nom": "Équipes", "lire": "public", "ecrire": "effectif", "categorie": true,
          "colonnes": ["nom", "categorieId", "competition"],
          "champs": [
            { "id": "nom", "type": "texte", "label": "Nom (ex. U15 A)", "requis": true },
            { "id": "saison", "type": "ref", "ref": "saisons", "label": "Saison" },
            { "id": "competition", "type": "texte", "label": "Championnat / niveau" },
            { "id": "entraineurs", "type": "refs", "ref": "personnes", "label": "Staff" },
            { "id": "joueurs", "type": "liste", "label": "Effectif affiché (nom, numéro, poste)" },
            { "id": "logo", "type": "image", "label": "Photo d'équipe" },
            { "id": "ordre", "type": "nombre", "label": "Ordre" }
          ] },
        { "id": "documents", "nom": "Dossiers", "lire": "effectif", "ecrire": "effectif", "perso": true, "categorie": true,
          "colonnes": ["personneId", "type", "expire"],
          "champs": [
            { "id": "personneId", "type": "ref", "ref": "personnes", "label": "Personne", "requis": true },
            { "id": "type", "type": "choix", "options": ["pièce d'identité", "extrait de naissance", "autorisation parentale", "certificat médical", "contrat", "autre"], "label": "Type" },
            { "id": "nom", "type": "texte", "label": "Nom" },
            { "id": "url", "type": "lien", "label": "Fichier" },
            { "id": "expire", "type": "date", "label": "Expire le" }
          ] }
